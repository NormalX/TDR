x = "Córners",
y = "Probabilidad"
) +
scale_color_manual(
values = c("Observado" = "black", "Poisson" = "deeppink", "Binomial Negativa" = "slateblue3"),
name = "Distribución"
) +
scale_x_continuous(
breaks = min(df_freq_corners_dis$Total_Corners):max(df_freq_corners_dis$Total_Corners)  # Mostrar todos los valores
) +
theme_minimal()
# Crear el gráfico con las distribuciones
ggplot(df_freq_corners_dis) +
geom_point(aes(x = Total_Corners, y = Prob, color = "Observado")) +  # Datos observados
geom_line(aes(x = Total_Corners, y = Prob_Poison, color = "Poisson")) +  # Poisson
geom_line(aes(x = Total_Corners, y = Prob_BN, color = "Binomial Negativa")) +  # Binomial Negativa
labs(
title = "Ajuste de Distribuciones",
x = "Córners",
y = "Probabilidad"
) +
scale_color_manual(
values = c("Observado" = "black", "Poisson" = "deeppink", "Binomial Negativa" = "slateblue3"),
name = "Distribución"
) +
scale_x_continuous(
breaks = min(df_freq_corners_dis$Total_Corners):max(df_freq_corners_dis$Total_Corners)  # Mostrar todos los valores
) +
theme_minimal()
# Realizar el test Chi-cuadrado para comparar la distribución observada con las esperadas
# Frecuencias observadas (transforma Prob a conteos si es necesario)
observed <- df_freq_corners_dis$Freq
# Frecuencias esperadas bajo Poisson (usa Prob_Poisson * total de partidos)
expected_pois <- df_freq_corners_dis$Prob_Poison * sum(df_freq_corners_dis$Freq)
# Frecuencias esperadas bajo Binomial Negativa
expected_nb <- df_freq_corners_dis$Prob_BN * sum(df_freq_corners_dis$Freq)
# Test Chi-cuadrado para Poisson
chi_pois <- chisq.test(observed, p = expected_pois, rescale.p = TRUE)
# Test Chi-cuadrado para Binomial Negativa
chi_nb <- chisq.test(observed, p = expected_nb, rescale.p = TRUE)
# Resultados
cat("Poisson - Estadístico X²:", chi_pois$statistic, "p-valor:", chi_pois$p.value, "\n")
# Resultados
cat("Poison - Estadístico X²:", chi_pois$statistic, "p-valor:", chi_pois$p.value, "\n")
cat("Binomial Negativa - Estadístico X²:", chi_nb$statistic, "p-valor:", chi_nb$p.value)
df_porcentaje_cum <- df_freq_corners_dis %>%
mutate(
across(c(Cum_Prob, Cum_Prob_BN, Cum_Prob_Pois),
~ paste0(round(.x * 100, 2), "%"))  # Convertir a % y añadir símbolo
)
View(df_porcentaje_cum)
# 1. Seleccionar solo las columnas necesarias y convertir a %
df_porcentaje <- df_freq_corners_dis %>%
select(
"Total_Corners",
"Observado" = "Cum_Prob",
"Binomial_Negativa" = "Cum_Prob_BN",
"Poisson" = "Cum_Prob_Pois"
) %>%
mutate(across(c(Observado, Binomial_Negativa, Poisson), ~ paste0(round(.x * 100, 2), "%")))
View(df_porcentaje)
library(kableExtra)
kable(df_porcentaje,
caption = "Probabilidades Acumuladas en Porcentaje",
col.names = c("Córners", "Observado (%)", "Binomial Negativa (%)", "Poisson (%)"),
align = c("c", "c", "c", "c")) %>%
kable_styling(
bootstrap_options = c("striped", "hover"),
full_width = FALSE,
font_size = 14
) %>%
column_spec(2:4, background = "#f7f7f7") %>%
footnote(general = "Los valores representan probabilidades acumuladas hasta cada número de córners.")
library(dplyr)
library(ggplot2)
library(scales) # Llireria per carregar la funció "percent()"
# Carreguem l'arxiu amb totes les dades dels partits de la temporada en un data frame
data_df <- read.csv("ESP_2025_M_1st_team_fb_match_sts_all.csv")
View(data_df)
View(data_df)
# Calculem el total de córners per partit
df_corners <- data_df %>%
group_by(Game_URL) %>%
summarise(Total_Corners = sum(CK_Pass_Types, na.rm = TRUE), .groups = "drop")
View(df_corners)
# Calculem la distribució de freqüències de córners fent servir la funció table()
# que compta el número de ocurrencies de cada categoria
freq_corners <- table(df_corners$Total_Corners)
# Convertir a data frame
df_freq_corners <- as.data.frame(freq_corners)
# Renombrem les columnes
colnames(df_freq_corners) <- c("Total_Corners", "Freq")
# Convertir a numèric
df_freq_corners$Total_Corners <- as.integer(as.character(df_freq_corners$Total_Corners))
View(df_freq_corners)
# Afegim els córners que falten (els que tenen freqüència 0)
# Crear un dataframe con todos los valores posibles de córners (de 0 al máximo encontrado)
all_corners <- data.frame(Total_Corners = 0:max(df_freq_corners$Total_Corners))
# Fusionar con tus datos existentes
df_freq_corners <- merge(all_corners, df_freq_corners, by = "Total_Corners", all.x = TRUE)
# Llenamos los faltantes (NA) con 0
df_freq_corners$Freq[is.na(df_freq_corners$Freq)] <- 0
View(df_corners)
View(df_freq_corners)
View(all_corners)
# Calcular total de partits
total_partidos <- sum(df_freq_corners$Freq)
# Calcular la probabilitat i la probabilitat acumulada (Regla de Laplace)
df_freq_corners <- df_freq_corners %>%
mutate(# Afegeix les columnes de probabilitat i probabilitat acumulada
Prob = Freq / total_partidos,
Cum_Prob = cumsum(Prob)
)
# Calcular la mitjana, la variància i la desviació típica
mean_corners <- sum(df_freq_corners$Total_Corners * df_freq_corners$Freq) / total_partidos
var_corners <- sum(df_freq_corners$Freq * (df_freq_corners$Total_Corners - mean_corners)^2) / total_partidos
sd_corners <- sqrt(var_corners)
# Crear el gràfic
plot <- ggplot(df_freq_corners, aes(x = Total_Corners, y = Freq)) +
geom_col(fill = "steelblue") +
# Probabilidad individual sobre la barra
geom_text(aes(label = percent(Prob)),
vjust = -0.5,
color = "black",
size = 3) +
# Probabilidad acumulada aún más arriba
geom_text(aes(label = percent(Cum_Prob)),
vjust = -1.5,
color = "red",
size = 3) +
# Número de partidos en el centro de la barra
geom_text(aes(label = Freq, y = Freq/2),
color = "white",
size = 3) +
scale_x_continuous(breaks = df_freq_corners$Total_Corners) +
labs(
title = "Distribució de Córners",
x = "Total de Córners",
y = "Frecuencia (Número de Partidos)"
) +
theme_minimal() +
# Línea vertical de la media
geom_vline(xintercept = mean_corners, linetype = "dashed", color = "red", size = 1) +
# Añadir la media en la esquina superior derecha
annotate("text", x = max(df_freq_corners$Total_Corners) * 0.95,
y = max(df_freq_corners$Freq) * 1.15,
label = paste("μ =", round(mean_corners, 2)),
color = "red", size = 4, hjust = 1, fontface = "bold") +
# Añadir desviación variancia en la esquina superior derecha
annotate("text", x = max(df_freq_corners$Total_Corners) * 0.95,
y = max(df_freq_corners$Freq) * 1.10,
label = paste("σ² =", round(var_corners, 2)),
color = "red", size = 4, hjust = 1, fontface = "bold") +
# Añadir desviación típica en la esquina superior derecha
annotate("text", x = max(df_freq_corners$Total_Corners) * 0.95,
y = max(df_freq_corners$Freq) * 1.05,
label = paste("σ =", round(sd_corners, 2)),
color = "red", size = 4, hjust = 1, fontface = "bold")
plot
# Calcular la media, la varianza y la desviación típica
mu <- mean_corners
variance <- var_corners
sigma <- sqrt(sd_corners)
# Parámetros de la Binomial Negativa
r <- mu^2 / (variance - mu)
p <- mu / variance
# Generar valores de k
k_values <- 0:21
# Calcular probabilidades individuales y acumuladas
prob_individual_binomial <- dnbinom(k_values, size = r, prob = p)
prob_cumulative_binomial <- pnbinom(k_values, size = r, prob = p)
prob_individual_poison <- dpois(k_values, lambda = mu)
prob_cumulative_poison <- ppois(k_values, lambda = mu)
# Añadir columnas de probabilidad empírica, binomial negativa y Poison
# Al final la que mejor ajusta es la Binomial Negativa
df_freq_corners_dis <- df_freq_corners %>%
mutate(
Prob_BN = prob_individual_binomial,
Cum_Prob_BN = prob_cumulative_binomial, # Prob. acumulada (BN)
Prob_Poison = round(prob_individual_poison, 4),  # Prob. individual (Poisson)
Cum_Prob_Pois = round(prob_cumulative_poison, 4)      # Prob. acumulada (Poisson)
)
